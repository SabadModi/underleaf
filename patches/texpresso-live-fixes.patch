diff --git a/src/engine/main/main.c b/src/engine/main/main.c
index 333408e..c2c36b3 100644
--- a/src/engine/main/main.c
+++ b/src/engine/main/main.c
@@ -230,6 +230,19 @@ ttbc_input_handle_t *ttstub_input_open(const char *path,
     char *ipath =
       txp_open(texpresso, id, path, kind_of_ttbc_format(format), TXP_READ);
 
+    // underleaf patch: \input{chapter} asks for "chapter". Try "chapter.tex" through
+    // the driver as well; otherwise the fopen fallback below reads it untracked and
+    // edits to included files never re-render.
+    char ext_path[PATH_MAX + 1];
+    for (const char **exts = format_extensions(format); !ipath && *exts; exts++)
+    {
+      if (strlen(path) + strlen(*exts) > PATH_MAX)
+        break;
+      strcpy(ext_path, path);
+      strcat(ext_path, *exts);
+      ipath = txp_open(texpresso, id, ext_path, kind_of_ttbc_format(format), TXP_READ);
+    }
+
     if (ipath)
     {
       strcpy(last_open, ipath);
